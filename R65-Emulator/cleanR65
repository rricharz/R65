#!/bin/bash
# cleanR65 - clean files before 'git add'

cd /home/rricharz/Projects/R65/R65-Emulator || exit 1

shopt -s nullglob

# Delete test files
files=(Files/test*.pas Listings/test*.txt)
((${#files[@]})) && rm -- "${files[@]}"

# Move files
files=(Files/*.pas)
((${#files[@]})) && mv -- "${files[@]}" Pascal/

files=(Files/*.asm)
((${#files[@]})) && mv -- "${files[@]}" Assembler/

files=(Files/*.help)
((${#files[@]})) && mv -- "${files[@]}" Help/

git status
