LIBRARY PLOTLIB;

CONSTANTS
      XSIZE=223;
      YSIZE=117;
      XWORDS=28;
      WHITE=0;
      INVERSE=1;
      BLACK=2;
      PLOTDEV=@128;

MEMORY
      KEYPRESSED=$1785: char&;

VARIABLES
      _xcursor, _ycursor: integer;

ROUTINES
proc _delay10msec(time:integer);
func _syncscreen;
proc _grinit;
proc _grend;
proc _cleargr;
proc _fullview;
proc _splitview;
proc _plot(x,y,c:integer);
proc _move(x,y:integer);
proc _draw(x,y,c:integer);
proc _plotmap(x,y,m:integer);
proc _waitforKEY;
