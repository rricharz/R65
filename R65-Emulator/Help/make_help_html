#!/bin/sh
# make_help_html
# Run this in the directory containing your .help files.

OUT="R65 Help Booklet.html"
TITLE="R65 Help Booklet"

# Build list of .help files in current directory
set -- ./*.help

# No .help files?
if [ ! -e "$1" ]; then
    echo "No .help files found."
    exit 1
fi

{
    echo '<!DOCTYPE html>'
    echo '<html lang="en">'
    echo '<head>'
    echo '  <meta charset="utf-8">'
    echo "  <title>$TITLE</title>"
    echo '  <style>'
    echo '    body {'
    echo '      font-family: Menlo, Monaco, "Courier New", monospace;'
    echo '      margin: 2em;'
    echo '      line-height: 1.25;'
    echo '      max-width: 60em;'
    echo '    }'
    echo '    h1 {'
    echo '      font-family: sans-serif;'
    echo '      margin-bottom: 1.5em;'
    echo '    }'
    echo '    h2 {'
    echo '      font-family: sans-serif;'
    echo '      margin-top: 2em;'
    echo '      border-bottom: 1px solid #888;'
    echo '      padding-bottom: 0.2em;'
    echo '    }'
    echo '    pre {'
    echo '      white-space: pre-wrap;'
    echo '      font-family: Menlo, Monaco, "Courier New", monospace;'
    echo '      font-size: 12pt;'
    echo '      margin-top: 1em;'
    echo '    }'
    echo '    .toc {'
    echo '      font-family: sans-serif;'
    echo '      margin-bottom: 3em;'
    echo '    }'
    echo '    .toc ul {'
    echo '      columns: 2;'
    echo '      -webkit-columns: 2;'
    echo '      -moz-columns: 2;'
    echo '    }'
    echo '    .section {'
    echo '      break-before: page;'
    echo '      page-break-before: always;'
    echo '    }'
    echo '    a { text-decoration: none; color: #0060c0; }'
    echo '  </style>'
    echo '</head>'
    echo '<body>'
    echo "  <h1>$TITLE</h1>"
    echo '  <div class="toc">'
    echo '    <h2>Contents</h2>'
    echo '    <ul>'
} > "$OUT"

for file in ./*.help
do
    base=$(basename "$file" .help)
    printf '      <li><a href="#%s">%s</a></li>\n' "$base" "$base" >> "$OUT"
done

{
    echo '    </ul>'
    echo '  </div>'
} >> "$OUT"

first=1

for file in ./*.help
do
    base=$(basename "$file" .help)

    printf '  <h2 class="section" id="%s">%s</h2>\n' "$base" "$base" >> "$OUT"

    echo '  <pre>' >> "$OUT"

    awk '
    {
        gsub(/&/, "\\&amp;");
        gsub(/</, "\\&lt;");
        gsub(/>/, "\\&gt;");
        print;
    }' "$file" >> "$OUT"

    echo '  </pre>' >> "$OUT"
done

{
    echo '</body>'
    echo '</html>'
} >> "$OUT"

echo "Created $OUT"