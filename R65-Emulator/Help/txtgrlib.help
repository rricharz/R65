LIBRARY TXTGRLIB;

CONSTANTS
  CYAN = 0;
  YELLOW = 1;
  TGR_UP    = $01;
  TGR_RIGHT = $02;
  TGR_DOWN  = $04;
  TGR_LEFT  = $08;

MEMORY
  NUMCHR = $178a: integer&;

ROUTINES
proc _txtgr(x,y,bits,color);
proc _htxtgr(xmin,xmax,y,color);
proc _vtxtgr(x,ymin,ymax,color);
proc _recttxtgr(xmin,xmax,ymin,ymax,color);
proc _writetxtgr(bits:integer);
proc _setcursor(x,y:integer);
proc _parkcursor;
