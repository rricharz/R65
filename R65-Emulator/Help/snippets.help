{ check for options }
if ARGTYPE[_carg]='s' then begin
  sortit  := option('S');
  full    := option('F');
  if not (sortit or full) then begin
    writeln('option must be /S or /F or /FS');
    exit;
  end;
end;

{ find file entry with best match }
  writeln;
  if not _bestmatch then begin
    writeln(CUP,INVVID,'File not found',NORVID);
    exit;
  end;
  writeln;