LIBRARY SPRTLIB;

CONSTANTS
      NSPRITES    = 44;
      FRAMES      = 3;
      S_CLEAR     = 0;
      S_STANDING  = 1;
      S_RIGHT     = 9;
      S_LEFT      = 32;
      S_UP        = 14;
      S_DOWN      = 35;
      S_JUMPR     = 38;
      S_JUMPL     = 41;
      S_TURN      = 19;

VARIABLES
      sprites: array[176] of integer;

ROUTINES
proc readsprites;
proc showsprite(x, y, index: integer);
