LIBRARY SYSLIB;

CONSTANTS
  TAB8     = chr(9);    
  HOM      = chr(1);    
  CSC      = chr($11);  
  LF       = chr($a);   
  FF       = chr($c);   
  CR       = chr($d);   
  EOF      = chr($7f);  
  CUP      = chr($1a);
  CLRLIN   = chr($17);
  NORVID   = chr($0b);  
  INVVID   = chr($0e);  
  PRTON    = chr($12);  
  PRTOFF   = chr($14);  
  TOPMEM   = $c780;     
  MAXINT   = $7fff;     
  INPUT    = @0;        
  OUTPUT   = @0;        
  KEY      = @1;        
  PRINTER  = @1;        
  ECEXPORT = 1;         
  ECIMPORT = 2;
  ECEDIT   = 3;
  EC_CLR_PRTOUT = 9;

MEMORY
  RUNERR   = $000c: integer&;
  FILERR   = $00db: integer&;
  ENDSTK   = $000e: integer;
  IOCHECK  = $0023: boolean&;
  CURPOS   = $00ee: integer&;

VARIABLES
  _day:    integer;
  _month:  integer;
  _year:   integer;

ROUTINES
func _emulator(i:integer): integer;
func _getbcd(address: integer): integer;
proc _getdate;
proc _prtdate(device: file);
func _abs(x: integer): integer;
func _mod(x,n: integer): integer;
proc _tab(pos: integer);
proc _abort;
func _random: integer;
func _readint(f:file; var n:integer): boolean;
func _isesc:boolean;
