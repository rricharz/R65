LIBRARY SYSLIB;

CONSTANTS
  TAB8     = chr(9);    
  HOM      = chr(1);    
  CSC      = chr($11);  
  LF       = chr($a);   
  FF       = chr($c);   
  CR       = chr($d);   
  EOF      = chr($7f);  
  CUP      = chr($1a);
  CLRLIN   = chr($17);
  NORVID   = chr($0b);  
  INVVID   = chr($0e);  
  PRTON    = chr($12);  
  PRTOFF   = chr($14);  
  MMAXSEQ  = 8;         
  TOPMEM   = $c780;     
  MAXINT   = $7fff;     
  INPUT    = @0;        
  OUTPUT   = @0;        
  KEY      = @1;        
  PRINTER  = @1;        

MEMORY
  RUNERR   = $000c: integer&;
  ENDSTK   = $000e: integer;
  BUFFPN   = $0015: integer&;
  IOCHECK  = $0023: boolean&;
  CURPOS   = $00ee: integer&;

VARIABLES
  _day:    integer;
  _month:  integer;
  _year:   integer;

ROUTINES
proc _setemucom(i:integer);
func _getbcd(address: integer): integer;
proc _getdate;
proc _prtdate(device: file);
func _abs(x: integer): integer;
func _mod(x,n: integer): integer;
proc _tab(pos: integer);
proc _abort;
proc _prtext8(device: file; text: array[7] of char);
proc _prtext16(device: file; text: array[15] of char);
func _random: integer;
proc __wrintf(value, width: integer);
