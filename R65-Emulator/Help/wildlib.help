LIBRARY WILDLIB;

CONSTANTS
      NAMESIZE   = 15;
      NUMENTRIES = 255;

MEMORY
      FILNAM=$0301: array[NAMESIZE] of char&;

ROUTINES
proc _test(s1:array[NAMESIZE] of char;
      var found:boolean);
proc _findentry(var nm:array[NAMESIZE] of char;
       drv:integer;var ent: integer;
       var fnd,lst:boolean);
proc _writename(nm1:array[15] of char);
