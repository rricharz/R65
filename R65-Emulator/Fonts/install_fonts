# install_fonts - install DSEG fonts
#
# run as superuser, e.g. sudo ./install_fonts

if [ "$(id -u)" -ne 0 ]; then
  echo "Please run as root: sudo ./install_fonts"
  exit 1
fi

install_fontdir() {
  DIR="$1"
  SRC="$2"

  mkdir -p "$DIR"
  cp $SRC "$DIR"/

  chmod 755 "$DIR"
  chmod 644 "$DIR"/*.ttf
}

install_fontdir /usr/share/fonts/truetype/DSEG7    "DSEG7/DSEG7*.ttf"
install_fontdir /usr/share/fonts/truetype/LedPanel "LedPanel/LedPanel.ttf"
install_fontdir /usr/share/fonts/truetype/basis33  "basis33/basis33.ttf"

fc-cache -f

echo "Installed fonts:"
fc-list "DSEG7 Classic"
fc-list "Led Panel Station On"
fc-list "basis33"